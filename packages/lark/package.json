{
  "name": "@dolphin/lark",
  "version": "2.6.5",
  "type": "module",
  "exports": {
    ".": {
      "dev": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./docx": {
      "dev": "./src/docx.ts",
      "types": "./dist/docx.d.mts",
      "default": "./dist/docx.mjs"
    },
    "./env": {
      "dev": "./src/env.ts",
      "types": "./dist/env.d.mts",
      "default": "./dist/env.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/mdast": "catalog:types",
    "@types/hast": "catalog:types"
  },
  "dependencies": {
    "@dolphin/common": "workspace:*",
    "mdast-util-gfm-strikethrough": "catalog:prod",
    "mdast-util-gfm-table": "catalog:prod",
    "mdast-util-gfm-task-list-item": "catalog:prod",
    "mdast-util-math": "catalog:prod",
    "mdast-util-to-markdown": "catalog:markdown",
    "es-toolkit": "catalog:prod"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
