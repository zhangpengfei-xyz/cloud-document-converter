{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**/*",
        "scripts/**/*",
        "images/**/*",
        "manifest.json",
        "popup.html",
        "tsconfig*.json",
        "tsdown.config.ts",
        "vite.config.ts",
        "../../pnpm-lock.yaml",
        "../../pnpm-workspace.yaml"
      ],
      "cache": true
    },
    "type-check": {}
  }
}
