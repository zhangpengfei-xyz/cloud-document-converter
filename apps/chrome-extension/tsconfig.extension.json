{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.extension.tsbuildinfo",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/background.ts",
    "src/content.ts",
    "src/env.d.ts",
    "src/chrome-types.d.ts",
    "src/common/*.ts",
    "src/lark/**/*.ts",
    "src/lark/**/*.d.ts",
    "src/shared/**/*.ts"
  ]
}
