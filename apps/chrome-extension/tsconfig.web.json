{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/env.d.ts",
    "src/scripts/*.ts",
    "src/common/*.ts",
    "src/lark/**/*.ts",
    "src/lark/**/*.d.ts",
    "src/shared/**/*.ts"
  ]
}
